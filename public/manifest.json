{
    "name": "Laravel Shop - Modern E-commerce",
    "short_name": "Laravel Shop",
    "description": "Modern e-commerce platform built with Laravel and Tailwind CSS",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#3b82f6",
    "orientation": "portrait-primary",
    "scope": "/",
    "lang": "vi",
    "dir": "ltr",
    "categories": ["shopping", "business", "productivity"],
    "icons": [
        {
            "src": "/frontend/images/logo-mail.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "/frontend/images/logo-mail.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "screenshots": [
        {
            "src": "/web_image1.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide"
        },
        {
            "src": "/web_image2.png",
            "sizes": "750x1334",
            "type": "image/png",
            "form_factor": "narrow"
        }
    ],
    "shortcuts": [
        {
            "name": "Tìm kiếm",
            "short_name": "Search",
            "description": "Tìm kiếm sản phẩm",
            "url": "/search",
            "icons": [
                {
                    "src": "/frontend/images/logo-mail.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Giỏ hàng",
            "short_name": "Cart",
            "description": "Xem giỏ hàng",
            "url": "/cart",
            "icons": [
                {
                    "src": "/frontend/images/logo-mail.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Tài khoản",
            "short_name": "Account",
            "description": "Quản lý tài khoản",
            "url": "/account",
            "icons": [
                {
                    "src": "/frontend/images/logo-mail.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "related_applications": [
        {
            "platform": "webapp",
            "url": "https://laravelshop.com/manifest.json"
        }
    ],
    "prefer_related_applications": false,
    "edge_side_panel": {
        "preferred_width": 400
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "handle_links": "preferred",
    "capture_links": "new-client",
    "file_handlers": [
        {
            "action": "/upload",
            "accept": {
                "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp"]
            }
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+laravelshop",
            "url": "/product?id=%s"
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "file",
                    "accept": ["image/*"]
                }
            ]
        }
    }
}