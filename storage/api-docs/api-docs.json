{
    "openapi": "3.0.0",
    "info": {
        "title": "ShopW API",
        "description": "Tài liệu API công khai và quản trị cho nền tảng thương mại điện tử ShopW.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Máy chủ ứng dụng hiện tại"
        }
    ],
    "paths": {
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Application health check",
                "operationId": "bee45ea1fde12cff60f4073927a9ca9d",
                "responses": {
                    "200": {
                        "description": "Application is healthy or degraded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "healthy"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "example": "2026-04-25T02:00:00.000000Z"
                                        },
                                        "version": {
                                            "type": "string",
                                            "example": "1.0.0"
                                        },
                                        "environment": {
                                            "type": "string",
                                            "example": "local"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Health",
            "description": "Health"
        }
    ]
}